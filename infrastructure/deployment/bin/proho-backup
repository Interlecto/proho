#!/bin/bash
# Dumps the proho database, encrypts it with the backup key's public half and
# uploads it to Cloudflare R2. Run nightly by proho-backup.timer and before
# every deployment. Needs age and rclone on the host.
# Installed as /usr/local/sbin/proho-backup.
set -euo pipefail

set -a
. /etc/proho/backup.env
set +a

# rclone reads its remote from these, so no secret goes on a command line.
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_R2_ENDPOINT="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
name="proho-$stamp.dump.age"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Custom format: compressed, and pg_restore can restore parts of it.
proho-compose exec -T postgres pg_dump --username postgres --format custom proho \
	| age --recipient "$BACKUP_AGE_RECIPIENT" >"$work/$name"

size="$(stat -c %s "$work/$name")"
if [ "$size" -lt 1024 ]; then
	echo "Backup is only $size bytes; not uploading it." >&2
	exit 1
fi

rclone copyto "$work/$name" "r2:$R2_BUCKET/daily/$name"
echo "Uploaded $name ($size bytes) to $R2_BUCKET/daily/"
