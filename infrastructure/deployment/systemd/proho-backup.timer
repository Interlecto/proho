# 03:30 in Colombia (UTC-5, no daylight saving), when communities are quiet.
[Unit]
Description=Nightly ProHo database backup

[Timer]
OnCalendar=*-*-* 08:30:00 UTC
RandomizedDelaySec=10min
# Runs at boot if the server was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
