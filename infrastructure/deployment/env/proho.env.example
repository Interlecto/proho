# /etc/proho/proho.env — the backend's settings (backend/README.md).
# Copy here, owned by root, mode 0600. Master copy of each password in
# Bitwarden (docs/security/secrets.md). Generate each with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# The backend refuses short, placeholder or shared passwords.
PROHO_DB_URL=jdbc:postgresql://postgres:5432/proho
PROHO_DB_USER=proho_app
PROHO_DB_PASSWORD=<generated>
PROHO_DB_MIGRATION_USER=proho
PROHO_DB_MIGRATION_PASSWORD=<generated, different>
