# /etc/proho/backup.env — nightly backups to Cloudflare R2 (bin/backup.sh).
# Root, mode 0600. Master copy of the key in Bitwarden.
#
# An R2 API token with "Object Read & Write" on the backup bucket only.
R2_ACCOUNT_ID=<Cloudflare account id>
R2_ACCESS_KEY_ID=<token access key id>
R2_SECRET_ACCESS_KEY=<token secret>
R2_BUCKET=proho-backups
# Public half of the backup encryption key (age-keygen). Dumps are encrypted
# before they leave the server; the private half lives only in Bitwarden, so
# neither R2 nor this server can read a backup.
BACKUP_AGE_RECIPIENT=age1...
