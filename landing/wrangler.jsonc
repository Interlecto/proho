{
  "name": "proho-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The worker runs first so non-canonical hosts (e.g. a workers.dev preview) redirect before any asset is served
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "proho.ilecto.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
